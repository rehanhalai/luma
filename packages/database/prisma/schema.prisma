generator client {
  provider = "prisma-client"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

model Map {
  id            Int      @id @default(autoincrement())
  name          String   // e.g. "Town Square"
  jsonPath      String   // e.g. "/assets/maps/town.json" (for Phaser)
  tilesetPath   String

  width         Int      @default(3840) 
  height        Int      @default(2880)

  spawnX        Int   @default(100)
  spawnY        Int   @default(100)

  // A map can be used by multiple rooms
  rooms     Room[]
  createdAt     DateTime @default(now())
}

model Room {
  id          Int      @id @default(autoincrement())
  name        String   // e.g. "Community Hangout"
  code        String   @unique // e.g. "town-1" or "lobby" (used in URL: ?room=lobby)
  description String? 
  maxCapacity Int      @default(50)
  
  // Relation to Map
  mapId       Int
  map         Map      @relation(fields: [mapId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Avatar {
  id    Int    @id @default(autoincrement())
  name  String
  path  String
  key   String @unique
  category String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
